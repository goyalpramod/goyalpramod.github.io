    {
      "id": "sq6kDv5LOFM523YvyaUQP",
      "type": "text",
      "x": 5785.822245689027,
      "y": -200.51308997932273,
      "width": 227.4999237060547,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU2",
      "roundness": null,
      "seed": 2117010864,
      "version": 170,
      "versionNonce": 1402872204,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "1. The sentence \nwe began with",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. The sentence \nwe began with",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ybdcs-sfo6JwVDzN2OlPk",
      "type": "text",
      "x": 6114.797423059705,
      "y": -195.51309008749087,
      "width": 369.43182373046875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU4",
      "roundness": null,
      "seed": 94778704,
      "version": 245,
      "versionNonce": 1358565388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "2. Each word is embedded*",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Each word is embedded*",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zse-7qLm0LkLu5uGOUVqg",
      "type": "text",
      "x": 6517.276391631045,
      "y": -637.1827166446619,
      "width": 471.93975830078125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU5",
      "roundness": null,
      "seed": 290793808,
      "version": 292,
      "versionNonce": 1238642316,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "3. Split into 8** heads. \nMultiple each heads weight matrix \n(W_Q,W_K,W_V)\nwith X or R",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Split into 8** heads. \nMultiple each heads weight matrix \n(W_Q,W_K,W_V)\nwith X or R",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2I5jhKtLPydf3E2ZOCGsU",
      "type": "text",
      "x": 6866.3065071346955,
      "y": -539.3673338359938,
      "width": 438.05987548828125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU6",
      "roundness": null,
      "seed": 913532752,
      "version": 482,
      "versionNonce": 249986316,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "4. Calculate Q,K,V of each head \nto get the attention score",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Calculate Q,K,V of each head \nto get the attention score",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8l7ajlnDmQpDFf0y0PUbb",
      "type": "text",
      "x": 7432.329655625239,
      "y": -651.0208426418224,
      "width": 773.2197265625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU7",
      "roundness": null,
      "seed": 1561400752,
      "version": 197,
      "versionNonce": 1235942284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "5. Join each attention head result and multiple with WO \nto get the final self-attention result",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Join each attention head result and multiple with WO \nto get the final self-attention result",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NmrlIfZDk5B_Fy8hoQFCh",
      "type": "text",
      "x": 5735.736556643595,
      "y": 336.60283582450677,
      "width": 802.2277221679688,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU8",
      "roundness": null,
      "seed": 1371156816,
      "version": 288,
      "versionNonce": 1683728908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "*Only for encoder_1 we start with X i.e embed the word, \nin all other encoder head (2,3...) we start with the output\nof the previous encoder (R)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*Only for encoder_1 we start with X i.e embed the word, \nin all other encoder head (2,3...) we start with the output\nof the previous encoder (R)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yU3Pk734_VNSB9K94SRBy",
      "type": "text",
      "x": 5729.203683194059,
      "y": 498.0186151785191,
      "width": 713.4957885742188,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bU9",
      "roundness": null,
      "seed": 1683764656,
      "version": 204,
      "versionNonce": 1911720076,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734931118359,
      "link": null,
      "locked": false,
      "text": "**8 is an architecture choice, not set in stone. You \nmay as well use 64",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**8 is an architecture choice, not set in stone. You \nmay as well use 64",
      "autoResize": true,
      "lineHeight": 1.25
    },
